
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        }
      },
      "required": [
        "id",
        "email"
      ]
    },
    "Annotation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Annotation",
      "type": "object",
      "description": "Represents a user's annotation on a portion of a verse.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the annotation."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Annotation)"
        },
        "translation": {
          "type": "string",
          "description": "The Bible translation used (e.g., BSB, WEB)."
        },
        "book": {
          "type": "string",
          "description": "The book of the Bible (e.g., JHN)."
        },
        "chapter": {
          "type": "number",
          "description": "The chapter number."
        },
        "verse": {
          "type": "number",
          "description": "The verse number."
        },
        "start": {
          "type": "number",
          "description": "The starting character offset of the annotated text within the verse."
        },
        "end": {
          "type": "number",
          "description": "The ending character offset of the annotated text within the verse."
        },
        "text": {
          "type": "string",
          "description": "The selected text content that is being annotated."
        },
        "note": {
          "type": "string",
          "description": "User's note for the selected text."
        },
        "highlight": {
          "type": "string",
          "description": "Highlight style applied to the selected text (e.g., hl-yellow, hl-green)."
        },
        "underline": {
          "type": "string",
          "description": "Underline style applied to the selected text (e.g., ul-red, ul-purple)."
        },
        "groupId": {
          "type": "string",
          "description": "Identifier to group multiple annotations that belong to a single user action (e.g., a multi-verse selection)."
        }
      },
      "required": [
        "id",
        "userId",
        "translation",
        "book",
        "chapter",
        "verse",
        "start",
        "end",
        "text"
      ]
    },
    "Bookmark": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Bookmark",
      "type": "object",
      "description": "Represents a bookmarked Bible verse.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the bookmark."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "translation": {
          "type": "string",
          "description": "The translation ID."
        },
        "book": {
          "type": "string",
          "description": "Book name."
        },
        "chapter": {
          "type": "number",
          "description": "Chapter number."
        },
        "verse": {
          "type": "number",
          "description": "Verse number."
        },
        "reference": {
          "type": "string",
          "description": "Formatted reference (e.g., 'John 3:16')."
        },
        "text": {
          "type": "string",
          "description": "A preview of the verse text."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "translation",
        "book",
        "chapter",
        "verse",
        "reference"
      ]
    },
    "JournalEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "JournalEntry",
      "type": "object",
      "description": "Represents a user's prayer journal entry.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the journal entry."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The date of the entry."
        },
        "reference": {
          "type": "string",
          "description": "Scripture reference associated with the entry."
        },
        "thoughts": {
          "type": "string",
          "description": "User's reflections and thoughts."
        },
        "prayer": {
          "type": "string",
          "description": "User's prayer requests and prayers."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "date"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles. User ID is used as the document ID.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/annotations/{annotationId}",
        "definition": {
          "entityName": "Annotation",
          "schema": {
            "$ref": "#/backend/entities/Annotation"
          },
          "description": "Stores individual annotations for each user.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            },
            {
              "name": "annotationId",
              "description": "The unique identifier for the annotation."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/bookmarks/{bookmarkId}",
        "definition": {
          "entityName": "Bookmark",
          "schema": {
            "$ref": "#/backend/entities/Bookmark"
          },
          "description": "Stores personal bookmarks for verses.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            },
            {
              "name": "bookmarkId",
              "description": "The unique identifier for the bookmark."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/journal/{entryId}",
        "definition": {
          "entityName": "JournalEntry",
          "schema": {
            "$ref": "#/backend/entities/JournalEntry"
          },
          "description": "Stores user prayer journal entries.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            },
            {
              "name": "entryId",
              "description": "The unique identifier for the journal entry."
            }
          ]
        }
      }
    ],
    "reasoning": "Data is isolated per user to ensure privacy and simple path-based security rules. Annotations, Bookmarks, and Journal entries are stored as subcollections of the user document."
  }
}
